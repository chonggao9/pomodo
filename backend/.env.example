# 复制此文件为 .env 并填写实际配置
# cp .env.example .env

NODE_ENV=development
PORT=3000

# PostgreSQL（docker-compose 默认配置）
DATABASE_URL="postgresql://flowtask:your_password@localhost:5432/flowtask?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT 密钥（生产环境必须使用随机长字符串）
JWT_SECRET=change_this_to_a_random_secret_string_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_random_secret_string
JWT_REFRESH_EXPIRES_IN=30d

# 前端地址（CORS 白名单）
FRONTEND_URL=http://localhost:4000
